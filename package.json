    "@changesets/cli": "^2.27.12",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "prisma": "^6.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mdirshadengineer/flowblitz.git"
  },
  "bugs": {
