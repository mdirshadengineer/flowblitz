{
  "name": "flowblitz.io",
  "version": "0.0.0",
  "description": "Automate. Innovate. Elevate.",
  "scripts": {
    "web": "pnpm --filter flowblitz-app-web start",
    "web:dev": "pnpm --filter flowblitz-app-web dev",
    "web:build": "pnpm --filter flowblitz-app-web build",
    "server:dev": "pnpm --filter flowblitz-app-server start:dev",
    "server:build": "pnpm --filter flowblitz-app-server build",
    "server:start": "pnpm --filter flowblitz-app-server start",
    "server:lint": "pnpm --filter flowblitz-app-server lint",
    "server:format": "pnpm --filter flowblitz-app-server format",
    "changeset": "changeset init",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "automation",
    "workflow"
  ],
  "author": {
    "name": "Md Irshad",
