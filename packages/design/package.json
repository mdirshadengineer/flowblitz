{
  "name": "@flowblitz/design-system",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/design-system.js",
  "module": "./dist/design-system.js",
  "files": [
    "./dist"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/design-system.js",
      "types": "./dist/types/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/types/components/*/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.types.json",
    "build:css": "tailwindcss -i ./src/tailwindcss.css -o ./dist/output.css",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3",
    "@eslint/js": "^9.21.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/pluginutils": "^5.1.4",
    "@storybook/addon-essentials": "8.6.6",
    "@storybook/addon-onboarding": "8.6.6",
    "@storybook/addon-themes": "^8.6.6",
    "@storybook/blocks": "8.6.6",
    "@storybook/experimental-addon-test": "8.6.6",
    "@storybook/react": "8.6.6",
    "@storybook/react-vite": "8.6.6",
    "@storybook/test": "8.6.6",
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/browser": "^3.0.8",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.11.4",
    "globals": "^15.15.0",
    "playwright": "^1.51.0",
    "react": "^19.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "8.6.6",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
